# http://editorconfig.org
root = true

[*]
indent_style = space
indent_size = 2
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
end_of_line = lf

[*.{js,ts}]
# Some teams prefer 4 spaces for TS; NestJS default templates often use 2
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.json]
indent_size = 2
